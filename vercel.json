{
  "buildCommand": "cd Biblia-Codex && npm install && npx vite build",
  "outputDirectory": "Biblia-Codex/dist",
  "devCommand": "cd Biblia-Codex && npm run dev",
  "installCommand": "cd Biblia-Codex && npm install",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/((?!.*\\.(?:json\\.gz|gz|db|wasm|mybible|zip|sqlite3|svg|js|css|png|jpg|jpeg|gif|ico|txt|html|webp|woff|woff2|ttf|eot)$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.json\\.gz",
      "headers": [
        {
          "key": "Content-Type",
          "value": "application/gzip"
        },
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        }
      ]
    }
  ]
}
